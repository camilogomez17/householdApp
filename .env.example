# Vercel adds BLOB_READ_WRITE_TOKEN when you connect a private Blob store.
HOUSEHOLD_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
HOUSEHOLD_TIME_ZONE=America/New_York
HOUSEHOLD_CURRENCY=USD
# Optional. Defaults to Household manager, Mom and Stepdad. Keep IDs stable.
# HOUSEHOLD_MEMBERS='[{"id":"owner","name":"Household manager","manager":true},{"id":"mom","name":"Mom"},{"id":"stepdad","name":"Stepdad"}]'
